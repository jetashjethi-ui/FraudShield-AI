# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Copy to .env.local and fill in.

# Base URL of the FastAPI service (uvicorn api:app --host 127.0.0.1 --port 8000)
FRAUDSHIELD_API_BASE_URL=http://127.0.0.1:8000

# Optional. Must match FRAUDSHIELD_API_KEY configured on the FastAPI process.
# Sent as X-API-Key only on POST /score, POST /batch and POST /roi.
FRAUDSHIELD_API_KEY=
